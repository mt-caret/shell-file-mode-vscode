{
  "name": "shell-file-mode",
  "displayName": "shell-file-mode",
  "description": "a port of shell-file.el to vscode",
  "publisher": "mtakeda",
  "version": "0.1.1",
  "license": "MIT",
  "repository": "github:mt-caret/shell-file-mode-vscode",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "menus": {
      "editor/title": [
        {
          "command": "shell-file-mode.insertShellFileBlock",
          "group": "navigation",
          "when": "resourceLangId == shellscript"
        },
        {
          "command": "shell-file-mode.runShellFileBlock",
          "group": "navigation",
          "when": "resourceLangId == shellscript"
        }
      ]
    },
    "configuration": [
      {
        "title": "Shell executable",
        "properties": {
          "shell-file-mode.shellExecutable": {
            "type": "string",
            "default": "/usr/bin/bash",
            "description": "To determine which bash executable to use"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "shell-file-mode.findShellFile",
        "title": "open a new shell-file."
      },
      {
        "command": "shell-file-mode.insertShellFileBlock",
        "title": "insert new block in shell file.",
        "icon": "$(add)"
      },
      {
        "command": "shell-file-mode.runShellFileBlock",
        "title": "run current block in shell file.",
        "icon": "$(notebook-execute)"
      }
    ],
    "keybindings": [
      {
        "command": "shell-file-mode.findShellFile",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "shell-file-mode.insertShellFileBlock",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorLangId == 'shellscript'"
      },
      {
        "command": "shell-file-mode.runShellFileBlock",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && editorLangId == 'shellscript'"
      },
      {
        "command": "shell-file-mode.runShellFileBlock",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == 'shellscript'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "vsce": "vsce package --allow-star-activation --out dist/shell-file-mode.vsix"
  },
  "devDependencies": {
    "@types/glob": "^8.0.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "@vscode/test-electron": "^2.2.2",
    "eslint": "^8.33.0",
    "glob": "^8.1.0",
    "mocha": "^10.1.0",
    "prettier": "^3.4.1",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "@vscode/vsce": "^2.23.0"
  }
}
